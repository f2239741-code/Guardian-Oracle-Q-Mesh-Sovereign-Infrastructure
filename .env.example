# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# GUARDIAN ORACLE / Q-MESH SOVEREIGN CRYPTOGRAPHIC IDENTITY SECRETS
# ==============================================================================
# CRITICAL: Private keys must NEVER be committed to source code or git history.
# In production, inject these 64-character hex scalars via secure secret managers (GCP Secret Manager, KMS, Vault).
# If omitted in local development/browser sandbox, the engine securely generates CSPRNG ephemeral keys.
# Any key derived from historical repository seeds is permanently blacklisted.

# Sovereign Root Authority Private Key (Secp256k1 64-character hex scalar)
SOVEREIGN_ROOT_PRIVATE_KEY=""

# Cascadia Mesh Root Certificate Authority Private Key (Secp256k1 64-character hex scalar)
CASCADIA_CA_PRIVATE_KEY=""

